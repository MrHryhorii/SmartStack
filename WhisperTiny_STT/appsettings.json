{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "Kestrel": {
    "Endpoints": {
      "Http": {
        "Url": "http://+:5050"
      }
    }
  },
  "Endpoints": {
    "EnableTranscription": true,
    "EnableTranslation": false
  },
  "ServerSecurity": {
    "MaxConcurrentInference": 4,
    "EnableRateLimiting": true,
    "RateLimitMaxRequests": 100,
    "RateLimitWindowSeconds": 60,
    "CorsAllowAnyOrigin": true,
    "CorsAllowedOrigins": [
      "http://localhost:3000",
      "http://127.0.0.1:3000",
      "http://localhost:11434",
      "http://127.0.0.1:11434",
      "http://localhost:5001",
      "http://127.0.0.1:5001",
      "http://localhost:5173",
      "http://localhost:8080",
      "http://localhost:5050"
    ]
  },
  "SttSettings": {
    "Language": "auto",
    "ExecutionProvider": "cpu",

    "VadSpeechThreshold": 0.5,
    "VadShortPauseSeconds": 0.4,
    "VadLongPauseSeconds": 0.8,
    "VadMinSpeechSeconds": 0.1,
    "VadMaxBufferSeconds": 60.0,

    "ModelDirectory": "models",
    "WhisperEncoderName": "tiny-encoder.onnx",
    "WhisperDecoderName": "tiny-decoder.onnx",
    "WhisperTokensName": "tiny-tokens.txt",
    "VadModelName": "silero_vad.onnx",
    "ExactEncoderFilePath": "",
    "ExactDecoderFilePath": "",
    "ExactTokensFilePath": "",
    "ExactVadFilePath": ""
  },
  "AutoDownload": {
    "Enable": true,
    "WhisperRepositoryUrl": "https://huggingface.co/Hinotsuba/sherpa-onnx-whisper-tiny/resolve/main/",
    "VadRepositoryUrl": "https://huggingface.co/Hinotsuba/silero_vad_ggml-base/resolve/main/"
  }
}