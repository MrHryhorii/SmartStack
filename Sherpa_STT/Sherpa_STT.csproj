<Project Sdk="Microsoft.NET.Sdk.Web">
  <!-- STT Runner: A lightweight, cross-platform speech-to-text server using Sherpa-ONNX and Silero VAD. -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <!-- AllowUnsafeBlocks is required for high-performance memory operations -->
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    
    <AssemblyName>Simple Sherpa STT</AssemblyName>
    <Version>1.0.0</Version>
    <Authors>MrHruhorii</Authors>
    <Description>A lightweight, cross-platform STT server using Sherpa-ONNX and Silero VAD.</Description>
  </PropertyGroup>
  
  <!-- Dependencies -->
  <ItemGroup>
    <!-- Web API and OpenAPI/Swagger support -->
    <PackageReference Include="Microsoft.AspNetCore.OpenApi" Version="10.0.7" />
    <PackageReference Include="Swashbuckle.AspNetCore" Version="10.1.7" />
    
    <!-- FFmpeg downloader and runtime -->    
    <PackageReference Include="Xabe.FFmpeg.Downloader" Version="6.0.2" />
    <PackageReference Include="Microsoft.ML.OnnxRuntime" Version="1.25.1" />
    
    <!-- Sherpa-ONNX speech recognition library -->
    <PackageReference Include="org.k2fsa.sherpa.onnx" Version="1.13.0" />
  </ItemGroup>
  
  <!-- Ensure appsettings.json is copied to the output directory -->
  <ItemGroup>
    <Content Update="appsettings.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>

  <!-- Ensure models are copied to the output directory -->
  <ItemGroup>
    <None Update="models\**\*">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>
</Project>