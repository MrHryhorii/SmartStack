{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "Kestrel": {
    "Endpoints": {
      "Http": {
        "Url": "http://+:5050"
      }
    }
  },
  "ServerSecurity": {
    "MaxConcurrentInference": 8,
    "EnableRateLimiting": true,
    "RateLimitMaxRequests": 100,
    "RateLimitWindowSeconds": 60,
    "CorsAllowAnyOrigin": true,
    "CorsAllowedOrigins": [
      "http://localhost:3000",
      "http://127.0.0.1:3000",
      "http://localhost:11434",
      "http://127.0.0.1:11434",
      "http://localhost:5001",
      "http://127.0.0.1:5001",
      "http://localhost:5173",
      "http://localhost:8080",
      "http://localhost:5050"
    ]
  },
  "SttSettings": {
    "ModelDirectory": "Models",
    "WhisperModelName": "ggml-base.bin",
    "VadModelName": "silero_vad.onnx",
    "ExactWhisperFilePath": "", 
    "ExactVadFilePath": "",
    "UseGpu": true,
    "GpuDeviceIndex": 0,
    "DefaultLanguage": "auto"
  },
  "AutoDownload": {
    "Enable": true,
    "RepositoryUrl": "https://huggingface.co/Hinotsuba/silero_vad_ggml-base/resolve/main/"
  }
}