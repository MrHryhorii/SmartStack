<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <DefaultItemExcludes>$(DefaultItemExcludes);Publish-Licensed/**;Tests/**</DefaultItemExcludes>

    <AssemblyName>TsubakiTTS</AssemblyName>
    <Version>1.0.10</Version>
    <ApplicationIcon>tsubaki.ico</ApplicationIcon>
    <PackageLicenseExpression>GPL-3.0-or-later</PackageLicenseExpression>
    <CopyOutputSymbolsToPublishDirectory>false</CopyOutputSymbolsToPublishDirectory>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Concentus" Version="2.2.2" />
    <PackageReference Include="Microsoft.OpenApi" Version="2.7.5" />
    <PackageReference Include="Microsoft.AspNetCore.OpenApi" Version="10.0.7" />
    <PackageReference Include="NAudio" Version="3.3.0" />
    <PackageReference Include="NAudio.Lame" Version="2.1.0" />
    <PackageReference Include="SearchPioneer.Lingua" Version="2.0.0" />
    <PackageReference Include="SoundTouch.Net" Version="2.3.2" />
    <PackageReference Include="SignalsmithStretch-CS" Version="1.1.2" />
    <PackageReference Include="Swashbuckle.AspNetCore" Version="10.1.7" />
  </ItemGroup>

  <PropertyGroup>
    <IsWindows Condition="$(RuntimeIdentifier.StartsWith('win')) Or ('$(RuntimeIdentifier)' == '' And $([MSBuild]::IsOSPlatform('Windows')))">true</IsWindows>
    <IsLinux Condition="$(RuntimeIdentifier.StartsWith('linux')) Or ('$(RuntimeIdentifier)' == '' And $([MSBuild]::IsOSPlatform('Linux')))">true</IsLinux>

    <IsOtherOS Condition="'$(IsWindows)' != 'true' And '$(IsLinux)' != 'true'">true</IsOtherOS>
  </PropertyGroup>

  <PropertyGroup Condition="'$(CpuOnly)' != 'true'">
    <EffectiveWebGpu Condition="'$(UseWebGpu)' == 'true' Or '$(IsOtherOS)' == 'true'">true</EffectiveWebGpu>
  </PropertyGroup>

  <PropertyGroup Condition="'$(CpuOnly)' != 'true'">
    <DefineConstants Condition="'$(IsLinux)' == 'true' And '$(EffectiveWebGpu)' != 'true'">$(DefineConstants);USE_CUDA</DefineConstants>
    <DefineConstants Condition="'$(IsWindows)' == 'true' And '$(EffectiveWebGpu)' != 'true'">$(DefineConstants);USE_DML</DefineConstants>
    <DefineConstants Condition="'$(EffectiveWebGpu)' == 'true'">$(DefineConstants);USE_WEBGPU</DefineConstants>
  </PropertyGroup>

  <!-- Both comparison profiles use the same inference gate and session-pool code. -->
  <PropertyGroup>
    <WebGpuRuntimeVersion>1.31.1</WebGpuRuntimeVersion>
    <WebGpuProviderVersion>0.5.0</WebGpuProviderVersion>
  </PropertyGroup>

  <PropertyGroup Condition="'$(WebGpuMemoryComparison)' == 'Legacy'">
    <WebGpuRuntimeVersion>1.29.0</WebGpuRuntimeVersion>
    <WebGpuProviderVersion>0.3.0</WebGpuProviderVersion>
    <DefineConstants>$(DefineConstants);WEBGPU_MEMORY_COMPARISON_LEGACY</DefineConstants>
  </PropertyGroup>

  <PropertyGroup Condition="'$(WebGpuMemoryComparison)' == 'Legacy' Or '$(WebGpuMemoryComparison)' == 'Current'">
    <DefineConstants>$(DefineConstants);WEBGPU_MEMORY_COMPARISON</DefineConstants>
  </PropertyGroup>

  <Target Name="ValidateWebGpuMemoryComparison" BeforeTargets="PrepareForBuild" Condition="'$(WebGpuMemoryComparison)' != ''">
    <Error Condition="'$(WebGpuMemoryComparison)' != 'Legacy' And '$(WebGpuMemoryComparison)' != 'Current'"
           Text="WebGpuMemoryComparison must be Legacy or Current." />
    <Error Condition="'$(EffectiveWebGpu)' != 'true' Or '$(CpuOnly)' == 'true'"
           Text="WebGPU memory comparison requires UseWebGpu=true and a GPU-enabled build." />
  </Target>

  <ItemGroup>
    <PackageReference Include="Microsoft.ML.OnnxRuntime" Version="$(WebGpuRuntimeVersion)" Condition="'$(CpuOnly)' == 'true' Or '$(EffectiveWebGpu)' == 'true'" />
    
    <PackageReference Include="Microsoft.ML.OnnxRuntime.DirectML" Version="1.24.4" Condition="'$(IsWindows)' == 'true' And '$(CpuOnly)' != 'true' And '$(EffectiveWebGpu)' != 'true'" />
    <PackageReference Include="Microsoft.ML.OnnxRuntime.Gpu" Version="1.29.0" Condition="'$(IsLinux)' == 'true' And '$(CpuOnly)' != 'true' And '$(EffectiveWebGpu)' != 'true'" />
    
    <PackageReference Include="Microsoft.ML.OnnxRuntime.EP.WebGpu" Version="$(WebGpuProviderVersion)" Condition="'$(EffectiveWebGpu)' == 'true' And '$(CpuOnly)' != 'true'" />
  </ItemGroup>

  <ItemGroup>
    <Content Update="TextChunkerRules.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
    </Content>
    <Content Remove="TextChunkerRules.example.json" />
    <None Include="TextChunkerRules.example.json" />
    <None Update="Model\**\*.onnx;Model\**\*.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
    </None>
    <None Update="Model\MODEL_PROVENANCE.txt">
      <TargetPath>THIRD_PARTY_LICENSES\Piper-Model-NOTICES.txt</TargetPath>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
    </None>
    
    <None Update="PiperNative\**\*.*" Condition="'$(IsWindows)' == 'true'">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
    </None>

    <None Update="PiperNative\espeak-ng-data\**\*.*" Condition="'$(IsLinux)' == 'true'">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
    </None>

    <None Update="PHOIBLE\**\*.*">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
    </None>

    <None Update="Cloner\**\*.*">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
    </None>

    <None Update="Voices\**\*.*">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
    </None>

    <None Update="THIRD_PARTY_NOTICES.txt">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
    </None>

    <None Update="LICENSE">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
    </None>

    <None Update="THIRD_PARTY_LICENSES\**\*.*">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
    </None>

    <None Update="Cloner\README.txt;THIRD_PARTY_LICENSES\DirectML\README.txt;THIRD_PARTY_LICENSES\SignalsmithStretch\PROVENANCE.txt">
      <CopyToOutputDirectory>Never</CopyToOutputDirectory>
      <CopyToPublishDirectory>Never</CopyToPublishDirectory>
    </None>

    <Content Update="appsettings.Development.json">
      <CopyToOutputDirectory>Never</CopyToOutputDirectory>
      <CopyToPublishDirectory>Never</CopyToPublishDirectory>
    </Content>

    <Content Update="tools\**\*">
      <CopyToOutputDirectory>Never</CopyToOutputDirectory>
      <CopyToPublishDirectory>Never</CopyToPublishDirectory>
    </Content>

    <Content Update="appsettings.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    
    <Content Update="wwwroot\**\*.*">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>

</Project>
