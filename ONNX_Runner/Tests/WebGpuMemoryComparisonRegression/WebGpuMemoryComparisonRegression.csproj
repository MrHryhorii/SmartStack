<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../../ONNX_Runner.csproj" AdditionalProperties="UseWebGpu=true" />
  </ItemGroup>
  <Target Name="RequireComparisonProfile" BeforeTargets="PrepareForBuild">
    <Error Condition="'$(WebGpuMemoryComparison)' != 'Legacy' And '$(WebGpuMemoryComparison)' != 'Current'"
           Text="Run these checks with WebGpuMemoryComparison=Legacy or Current." />
  </Target>
</Project>
