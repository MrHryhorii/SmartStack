<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <!-- Isolate exact allocation accounting from background GC in the test host only. -->
    <ConcurrentGarbageCollection>false</ConcurrentGarbageCollection>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../../ONNX_Runner.csproj" />
    <Compile Include="../ServerConfigurationRegression/AllocationChecks.cs" Link="AllocationChecks.cs" />
    <Compile Include="../ServerConfigurationRegression/RingMixingChecks.cs" Link="RingMixingChecks.cs" />
    <EmbeddedResource Include="../ServerConfigurationRegression/RingCurveMoments.json" LogicalName="RingCurveMoments.json" />
  </ItemGroup>
</Project>
