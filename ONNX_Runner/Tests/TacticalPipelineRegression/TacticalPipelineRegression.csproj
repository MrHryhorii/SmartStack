    <Compile Include="../ServerConfigurationRegression/TacticalMixingChecks.cs" Link="TacticalMixingChecks.cs" />
    <Compile Include="../ServerConfigurationRegression/CharacterStrengthChecks.cs" Link="CharacterStrengthChecks.cs" />
    <Compile Include="../ServerConfigurationRegression/AudioEffectSampleRateChecks.cs" Link="AudioEffectSampleRateChecks.cs" />
    <EmbeddedResource Include="../ServerConfigurationRegression/FmCurveMoments.json" LogicalName="FmCurveMoments.json" />
