<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <!-- Exact allocation checks use the same isolated accounting as the main regression host. -->
    <ConcurrentGarbageCollection>false</ConcurrentGarbageCollection>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../../ONNX_Runner.csproj" />
    <Compile Include="../ServerConfigurationRegression/AllocationChecks.cs" Link="AllocationChecks.cs" />
    <Compile Include="../ServerConfigurationRegression/ChorusMixingChecks.cs" Link="ChorusMixingChecks.cs" />
    <Compile Include="../ServerConfigurationRegression/FlangerMixingChecks.cs" Link="FlangerMixingChecks.cs" />
    <Compile Include="../ServerConfigurationRegression/ModulationCurveChecks.cs" Link="ModulationCurveChecks.cs" />
    <Compile Include="../ServerConfigurationRegression/ModulationLevelChecks.cs" Link="ModulationLevelChecks.cs" />
    <EmbeddedResource Include="../ServerConfigurationRegression/ModulationCurveMoments.json" LogicalName="ModulationCurveMoments.json" />
  </ItemGroup>
</Project>
